{
  "name": "trace-logos",
  "version": "0.1.0",
  "description": "Find and download brand logos (SVG/PNG) from the Trace Logo's catalog: CLI and Node.js API. Zero dependencies.",
  "keywords": ["logo", "logos", "svg", "png", "brand", "icons", "cli", "russian-brands"],
  "license": "MIT",
  "homepage": "https://trace-logos.ru/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturablyazov5-glitch/trace-logos-integrations.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/arturablyazov5-glitch/trace-logos-integrations/issues"
  },
  "type": "module",
  "bin": {
    "trace-logos": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.js\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
